# Copiar a apps/api/.env o usar el .env de la raíz del monorepo
DATABASE_URL="postgresql://bogados:bogados@127.0.0.1:15432/bogados?schema=public"
JWT_SECRET="cambia-este-jwt-secreto-en-local"
JWT_EXPIRES_IN="7d"
PORT=3001
UPLOAD_DIR="./uploads"
CORS_ORIGIN="http://localhost:3000"
# Correo: invitaciones y recuperar contraseña (Mailpit en local: http://localhost:8025)
SMTP_URL="smtp://127.0.0.1:1025"
MAIL_FROM="Bogados <no-reply@bogados.local>"
APP_URL="http://localhost:3000"
NODE_ENV="development"
