// Bogados — esquema multi-tenant (tenant = firma)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ABOGADO
  CLIENTE
}

enum CaseStatus {
  intake
  abierto
  en_pausa
  cerrado
}

/// Caso pedido por un cliente desde el portal y la decisión del despacho
enum CaseRequestState {
  pendiente
  aplazada
  aceptada
  rechazada
}

enum AppointmentStatus {
  pendiente
  confirmada
  cancelada
  completada
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  /// Zona horaria IANA de la firma: la disponibilidad se expresa en hora local
  timezone           String   @default("America/Guayaquil")
  /// Duración de cada cita reservable, en minutos
  appointmentMinutes Int      @default(60)
  /// Exige verificación en dos pasos al equipo (admin y abogados; los clientes, si la activan ellos)
  requireTwoFactor   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users          User[]
  cases          Case[]
  documents      Document[]
  messages       Message[]
  notes          CaseNote[]
  activityEvents ActivityEvent[]
  tasks          CaseTask[]
  availability   Availability[]
  appointments   Appointment[]
  holidays       Holiday[]
  loginEvents    LoginEvent[]
}

model User {
  id                String    @id @default(cuid())
  tenantId          String
  email             String
  passwordHash      String
  name              String
  role              Role
  active            Boolean   @default(true)
  /// Los JWT emitidos antes de esta fecha dejan de ser válidos
  passwordChangedAt DateTime?
  /// Al entrar, además de la contraseña, se pide un código enviado por email
  twoFactorEnabled  Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  casesAsLawyer        Case[]           @relation("CaseLawyer")
  casesAsClient        Case[]           @relation("CaseClient")
  documentsUploaded    Document[]       @relation("DocumentUploader")
  messagesSent         Message[]        @relation("MessageSender")
  notesAuthored        CaseNote[]       @relation("NoteAuthor")
  activityEvents       ActivityEvent[]  @relation("ActivityActor")
  tasksAssigned        CaseTask[]       @relation("TaskAssignee")
  notifications        Notification[]
  tokens               UserToken[]
  loginEvents          LoginEvent[]
  loginChallenges      LoginChallenge[]
  availability         Availability[]
  appointmentsAsLawyer Appointment[]    @relation("AppointmentLawyer")
  appointmentsAsClient Appointment[]    @relation("AppointmentClient")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Case {
  id             String            @id @default(cuid())
  tenantId       String
  title          String
  description    String?
  matterType     String?
  /// Número del proceso judicial en el SATJE (p. ej. 13284-2024-00123); null si aún no se ha presentado
  processNumber  String?
  status         CaseStatus        @default(intake)
  lawyerId       String?
  clientId       String?
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  /// Solo en casos pedidos por el cliente desde el portal (null = creado por el despacho)
  requestState   CaseRequestState?
  /// Motivo que se comunica al cliente al aplazar o rechazar
  decisionReason String?
  decidedAt      DateTime?
  decidedById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lawyer         User?           @relation("CaseLawyer", fields: [lawyerId], references: [id])
  client         User?           @relation("CaseClient", fields: [clientId], references: [id])
  documents      Document[]
  messages       Message[]
  notes          CaseNote[]
  activityEvents ActivityEvent[]
  tasks          CaseTask[]
  appointments   Appointment[]

  @@index([tenantId, status])
  @@index([tenantId, lawyerId])
  @@index([tenantId, clientId])
  @@index([tenantId, requestState])
  @@index([tenantId, processNumber])
}

model Document {
  id               String   @id @default(cuid())
  tenantId         String
  caseId           String
  fileName         String
  mimeType         String
  sizeBytes        Int
  storagePath      String
  sharedWithClient Boolean  @default(false)
  uploadedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case       Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([tenantId, caseId])
}

model Message {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender User   @relation("MessageSender", fields: [senderId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

/// Notas / timeline. Si isInternal=true, el cliente NO las ve.
model CaseNote {
  id         String   @id @default(cuid())
  tenantId   String
  caseId     String
  authorId   String
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User   @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

/// Eventos de auditoría / timeline por caso
model ActivityEvent {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  actorId   String?
  type      String
  summary   String
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor  User?  @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

/// Tareas / plazos asociados a un caso
model CaseTask {
  id         String    @id @default(cuid())
  tenantId   String
  caseId     String
  title      String
  dueAt      DateTime
  /// Si el plazo es un término procesal: días hábiles y fecha de notificación desde la que se cuentan.
  /// Permiten mostrar cómo se calculó el vencimiento (dueAt).
  termDays   Int?
  notifiedOn DateTime? @db.Date
  done       Boolean   @default(false)
  assigneeId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case     Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId, caseId])
  @@index([tenantId, dueAt, done])
  @@index([tenantId, assigneeId])
}

/// Franja semanal en la que un abogado atiende citas, en hora local de la firma
model Availability {
  id       String @id @default(cuid())
  tenantId String
  lawyerId String
  /// 0 = domingo … 6 = sábado (como Date.getDay)
  weekday  Int
  /// Minutos desde las 00:00
  startMin Int
  endMin   Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lawyer User   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  @@index([tenantId, lawyerId])
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  lawyerId       String
  clientId       String
  caseId         String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(pendiente)
  /// Motivo indicado al pedir la cita
  reason         String?
  /// Comentario del despacho al confirmar o cancelar
  note           String?
  createdById    String
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lawyer User   @relation("AppointmentLawyer", fields: [lawyerId], references: [id], onDelete: Cascade)
  client User   @relation("AppointmentClient", fields: [clientId], references: [id], onDelete: Cascade)
  case   Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([tenantId, lawyerId, startsAt])
  @@index([tenantId, clientId, startsAt])
  @@index([status, startsAt])
}

enum UserTokenType {
  INVITE
  RESET
}

/// Enlaces de un solo uso (invitación / recuperar contraseña). Solo se guarda el hash.
model UserToken {
  id        String        @id @default(cuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Notificaciones in-app por usuario
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

/// Día no hábil del bufete (feriado nacional, local o traslado). Los términos procesales no lo cuentan.
model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
}

/// Intento de acceso, correcto o fallido: registro de seguridad de la firma
model LoginEvent {
  id        String   @id @default(cuid())
  tenantId  String
  /// Nulo si el email no corresponde a ningún usuario de la firma
  userId    String?
  email     String
  success   Boolean
  /// Éxito: password | two_factor. Fallo: bad_password | unknown_user | inactive | bad_code | expired_code
  reason    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

/// Segundo paso del acceso: código de 6 dígitos enviado por email
model LoginChallenge {
  id         String    @id @default(cuid())
  userId     String
  /// Solo el hash: quien lea la tabla no puede usar el código
  codeHash   String
  remember   Boolean   @default(false)
  attempts   Int       @default(0)
  sends      Int       @default(1)
  expiresAt  DateTime
  lastSentAt DateTime  @default(now())
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
