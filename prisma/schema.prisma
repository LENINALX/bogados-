// Bogados — esquema multi-tenant (tenant = firma)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ABOGADO
  CLIENTE
}

enum CaseStatus {
  intake
  abierto
  en_pausa
  cerrado
}

enum AppointmentStatus {
  pendiente
  confirmada
  cancelada
  completada
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Zona horaria IANA de la firma: la disponibilidad se expresa en hora local
  timezone  String   @default("America/Guayaquil")
  /// Duración de cada cita reservable, en minutos
  appointmentMinutes Int @default(60)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  cases          Case[]
  documents      Document[]
  messages       Message[]
  notes          CaseNote[]
  activityEvents ActivityEvent[]
  tasks          CaseTask[]
  availability   Availability[]
  appointments   Appointment[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  /// Los JWT emitidos antes de esta fecha dejan de ser válidos
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  casesAsLawyer     Case[]         @relation("CaseLawyer")
  casesAsClient     Case[]         @relation("CaseClient")
  documentsUploaded Document[]     @relation("DocumentUploader")
  messagesSent      Message[]      @relation("MessageSender")
  notesAuthored     CaseNote[]     @relation("NoteAuthor")
  activityEvents    ActivityEvent[] @relation("ActivityActor")
  tasksAssigned     CaseTask[]     @relation("TaskAssignee")
  notifications     Notification[]
  tokens            UserToken[]
  availability      Availability[]
  appointmentsAsLawyer Appointment[] @relation("AppointmentLawyer")
  appointmentsAsClient Appointment[] @relation("AppointmentClient")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Case {
  id          String     @id @default(cuid())
  tenantId    String
  title       String
  description String?
  matterType  String?
  status      CaseStatus @default(intake)
  lawyerId    String?
  clientId    String?
  openedAt    DateTime   @default(now())
  closedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lawyer         User?           @relation("CaseLawyer", fields: [lawyerId], references: [id])
  client         User?           @relation("CaseClient", fields: [clientId], references: [id])
  documents      Document[]
  messages       Message[]
  notes          CaseNote[]
  activityEvents ActivityEvent[]
  tasks          CaseTask[]
  appointments   Appointment[]

  @@index([tenantId, status])
  @@index([tenantId, lawyerId])
  @@index([tenantId, clientId])
}

model Document {
  id               String   @id @default(cuid())
  tenantId         String
  caseId           String
  fileName         String
  mimeType         String
  sizeBytes        Int
  storagePath      String
  sharedWithClient Boolean  @default(false)
  uploadedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case       Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([tenantId, caseId])
}

model Message {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender User   @relation("MessageSender", fields: [senderId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

/// Notas / timeline. Si isInternal=true, el cliente NO las ve.
model CaseNote {
  id         String   @id @default(cuid())
  tenantId   String
  caseId     String
  authorId   String
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User   @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

/// Eventos de auditoría / timeline por caso
model ActivityEvent {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  actorId   String?
  type      String
  summary   String
  meta      Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor  User?  @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

/// Tareas / plazos asociados a un caso
model CaseTask {
  id         String   @id @default(cuid())
  tenantId   String
  caseId     String
  title      String
  dueAt      DateTime
  done       Boolean  @default(false)
  assigneeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case     Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assignee User?  @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId, caseId])
  @@index([tenantId, dueAt, done])
  @@index([tenantId, assigneeId])
}

/// Franja semanal en la que un abogado atiende citas, en hora local de la firma
model Availability {
  id       String @id @default(cuid())
  tenantId String
  lawyerId String
  /// 0 = domingo … 6 = sábado (como Date.getDay)
  weekday  Int
  /// Minutos desde las 00:00
  startMin Int
  endMin   Int

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lawyer User   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  @@index([tenantId, lawyerId])
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  lawyerId       String
  clientId       String
  caseId         String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(pendiente)
  /// Motivo indicado al pedir la cita
  reason         String?
  /// Comentario del despacho al confirmar o cancelar
  note           String?
  createdById    String
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lawyer User   @relation("AppointmentLawyer", fields: [lawyerId], references: [id], onDelete: Cascade)
  client User   @relation("AppointmentClient", fields: [clientId], references: [id], onDelete: Cascade)
  case   Case?  @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([tenantId, lawyerId, startsAt])
  @@index([tenantId, clientId, startsAt])
  @@index([status, startsAt])
}

enum UserTokenType {
  INVITE
  RESET
}

/// Enlaces de un solo uso (invitación / recuperar contraseña). Solo se guarda el hash.
model UserToken {
  id        String        @id @default(cuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Notificaciones in-app por usuario
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}
