// Bogados — esquema multi-tenant (tenant = firma)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ABOGADO
  CLIENTE
}

enum CaseStatus {
  intake
  abierto
  en_pausa
  cerrado
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  cases     Case[]
  documents Document[]
  messages  Message[]
  notes     CaseNote[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  casesAsLawyer       Case[]     @relation("CaseLawyer")
  casesAsClient       Case[]     @relation("CaseClient")
  documentsUploaded   Document[] @relation("DocumentUploader")
  messagesSent        Message[]  @relation("MessageSender")
  notesAuthored       CaseNote[] @relation("NoteAuthor")

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Case {
  id          String     @id @default(cuid())
  tenantId    String
  title       String
  description String?
  matterType  String?
  status      CaseStatus @default(intake)
  lawyerId    String?
  clientId    String?
  openedAt    DateTime   @default(now())
  closedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lawyer    User?      @relation("CaseLawyer", fields: [lawyerId], references: [id])
  client    User?      @relation("CaseClient", fields: [clientId], references: [id])
  documents Document[]
  messages  Message[]
  notes     CaseNote[]

  @@index([tenantId, status])
  @@index([tenantId, lawyerId])
  @@index([tenantId, clientId])
}

model Document {
  id           String   @id @default(cuid())
  tenantId     String
  caseId       String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  sharedWithClient Boolean @default(false)
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case       Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([tenantId, caseId])
}

model Message {
  id        String   @id @default(cuid())
  tenantId  String
  caseId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sender User   @relation("MessageSender", fields: [senderId], references: [id])

  @@index([tenantId, caseId, createdAt])
}

/// Notas / timeline. Si isInternal=true, el cliente NO las ve.
model CaseNote {
  id         String   @id @default(cuid())
  tenantId   String
  caseId     String
  authorId   String
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User   @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([tenantId, caseId, createdAt])
}
