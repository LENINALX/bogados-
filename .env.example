# Copiar a .env en la raíz del monorepo
# Base de datos (docker compose)
DATABASE_URL="postgresql://bogados:bogados@localhost:5432/bogados?schema=public"

# Auth.js / NextAuth — generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-este-secreto-en-local"
NEXTAUTH_URL="http://localhost:3000"

# Almacenamiento local de documentos (ruta relativa al cwd de Next o absoluta)
UPLOAD_DIR="./uploads"

# Node
NODE_ENV="development"
