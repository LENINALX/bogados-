# Copiar a .env en la raíz del monorepo
# Base de datos (docker compose)
DATABASE_URL="postgresql://bogados:bogados@127.0.0.1:15432/bogados?schema=public"

# Auth.js / NextAuth (apps/web) — generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-este-secreto-en-local"
NEXTAUTH_URL="http://localhost:3000"

# NestJS API JWT (apps/api) — fuente de verdad para casos/docs/mensajes
JWT_SECRET="cambia-este-jwt-secreto-en-local"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Frontend → Nest API
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# Opcional: URL de la API vista desde el servidor de Next (login de NextAuth).
# Si no se define, se usa NEXT_PUBLIC_API_URL.
# NEST_API_URL="http://localhost:3001/api/v1"

# Correo (invitaciones y recuperar contraseña). En local: docker compose up -d mailpit
# y abre http://localhost:8025 para ver los emails. Sin SMTP_URL, en desarrollo el
# email (con su enlace) se escribe en el log de la API.
SMTP_URL="smtp://127.0.0.1:1025"
MAIL_FROM="Bogados <no-reply@bogados.local>"
# URL de la web: base de los enlaces que llegan por email
APP_URL="http://localhost:3000"

# Recordatorios de citas (24 h antes, cada 30 min). Pon "false" para desactivarlos.
REMINDERS_ENABLED="true"

# Almacenamiento local de documentos
UPLOAD_DIR="./uploads"

# Node
NODE_ENV="development"
