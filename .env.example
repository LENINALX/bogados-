# Copiar a .env en la raíz del monorepo
# Base de datos (docker compose)
DATABASE_URL="postgresql://bogados:bogados@127.0.0.1:15432/bogados?schema=public"

# Auth.js / NextAuth (apps/web) — generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-este-secreto-en-local"
NEXTAUTH_URL="http://localhost:3000"

# NestJS API JWT (apps/api) — fuente de verdad para casos/docs/mensajes
JWT_SECRET="cambia-este-jwt-secreto-en-local"
JWT_EXPIRES_IN="7d"
# Secreto compartido web↔API: con él la API cree la IP y el navegador que reenvía el login
# de la web (registro de accesos). Sin él, la API no se fía de ninguna cabecera reenviada (ni en
# desarrollo) y usa la IP de la conexión. Genera uno con: openssl rand -base64 32
CLIENT_FORWARD_SECRET=""
# Solo con un proxy de confianza delante de la web (nginx, Caddy…) que añada la IP real al final de
# X-Forwarded-For. Sin proxy déjalo vacío: esa cabecera la escribiría el navegador.
TRUSTED_PROXY=""
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Frontend → Nest API
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# Muestra las cuentas de demostración en la pantalla de acceso también en producción
# (en desarrollo se muestran siempre). Déjalo vacío en una instalación real.
NEXT_PUBLIC_DEMO_MODE=""
# Opcional: URL de la API vista desde el servidor de Next (login de NextAuth).
# Si no se define, se usa NEXT_PUBLIC_API_URL.
# NEST_API_URL="http://localhost:3001/api/v1"

# Correo (invitaciones y recuperar contraseña). En local: docker compose up -d mailpit
# y abre http://localhost:8025 para ver los emails. Sin SMTP_URL, en desarrollo el
# email (con su enlace) se escribe en el log de la API.
SMTP_URL="smtp://127.0.0.1:1025"
MAIL_FROM="Bogados <no-reply@bogados.local>"
# URL de la web: base de los enlaces que llegan por email
APP_URL="http://localhost:3000"

# Recordatorios de citas (24 h antes, cada 30 min). Pon "false" para desactivarlos.
REMINDERS_ENABLED="true"

# Almacenamiento local de documentos
UPLOAD_DIR="./uploads"

# Node. Swagger y los correos escritos en el log (sin SMTP_URL) solo funcionan con
# "development" o "test" puestos a mano: si falta, la API se comporta como en producción.
NODE_ENV="development"

# Borrado nocturno de datos personales caducados (registro de accesos a los 180 días, intentos
# con emails desconocidos a los 30, enlaces y códigos usados). "false" lo desactiva.
RETENTION_ENABLED="true"

# Contraseña de Postgres para docker compose (por defecto «bogados», solo para tu equipo)
# POSTGRES_PASSWORD=""

# Alta pública de nuevas firmas en /registro (por defecto abierta). "false" la cierra.
SIGNUP_ENABLED="true"

# Documentación interactiva de la API (/api/docs). En producción solo si es "true".
SWAGGER_ENABLED=""
